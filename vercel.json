{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/instagram-refresh",
      "schedule": "0 8 1 * *"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/journal/:slug",
      "destination": "/api/journal-render?slug=:slug"
    },
    {
      "source": "/journal/:slug/",
      "destination": "/api/journal-render?slug=:slug"
    }
  ]
}
